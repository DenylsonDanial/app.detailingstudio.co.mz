{
  "name": "app-detailingstudio",
  "version": "0.1.0",
  "description": "Frontend do sistema de gestao Detailing Studio (Minimals + MUI + Vite + TS)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "start": "vite preview",
